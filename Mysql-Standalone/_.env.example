# Copy to .env and edit:  cp .env.example .env
# Never commit .env to Git.

# --- Image ---
# Pinned MySQL version. Check the latest 8.4.x patch on Docker Hub
# (https://hub.docker.com/_/mysql) and update deliberately.
MYSQL_VERSION=8.4.5

# --- Container ---
CONTAINER_NAME=mysql
TZ=UTC

# --- Network ---
# 127.0.0.1 = reachable from this host only (safe default).
# 0.0.0.0   = reachable from the network (use a firewall).
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306

# --- Credentials (applied only on first start, empty data volume) ---
# Generate a strong password, e.g.:  openssl rand -base64 24 | tr -d '/+=$'
# Avoid the "$" character: Compose treats it as variable interpolation.
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Optional application database and user (leave empty to skip).
# MYSQL_USER and MYSQL_PASSWORD must be set together. MYSQL_USER cannot be "root".
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
